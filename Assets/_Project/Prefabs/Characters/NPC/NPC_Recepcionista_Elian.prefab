      value: Inicio
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].id
      value: Panel
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].id
      value: Misterio
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[3].id
      value: Final
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].texto
      value: Buenas noches. Para llegar a las habitaciones, debe desbloquear la puerta del fondo.
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].texto
      value: "Debe presionar los cuatro s\xEDmbolos en el orden correcto."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].texto
      value: "Este hotel guarda m\xE1s secretos de los que deber\xEDa."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[3].texto
      value: "La puerta lo espera. Hable con L\xEDa y no se equivoque"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[0].texto
      value: "\xBFC\xF3mo abro la puerta?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[1].texto
      value: "\xBFD\xF3nde est\xE1n las habitaciones?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[2].texto
      value: "\xBFQu\xE9 pas\xF3 en este hotel?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[0].texto
      value: "\xBFY cu\xE1l es el orden?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[1].texto
      value: "\xBFQu\xE9 pasa si me equivoco?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[2].texto
      value: "\xBFUsted no puede abrirla?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[0].texto
      value: "Mejor d\xEDgame c\xF3mo avanzar."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[1].texto
      value: "\xBFQu\xE9 secretos?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[2].texto
      value: "\xBFEs peligroso seguir?"
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[0].respuestaNPC
      value: "Con los cuatro s\xEDmbolos del mostrador."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[1].respuestaNPC
      value: Al otro lado de esa puerta.
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[2].respuestaNPC
      value: Hay cosas que es mejor no recordar.
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[0].respuestaNPC
      value: "Su hermana L\xEDa puede ver lo que usted no. Preg\xFAntele."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[1].respuestaNPC
      value: El mecanismo se reinicia.
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[2].respuestaNPC
      value: No. Solo ustedes pueden hacerlo.
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[0].respuestaNPC
      value: "Active los s\xEDmbolos del mostrador."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[1].respuestaNPC
      value: "Algunos hu\xE9spedes nunca se marcharon."
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[2].respuestaNPC
      value: Solo si escucha que alguien lo llama.
      objectReference: {fileID: 0}
    - target: {fileID: 4524337077287772260, guid: af19f74e919ddcf4da3aafffadf1cd90, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[0].siguienteNodo
      value: Panel
      objectReference: {fileID: 0}
