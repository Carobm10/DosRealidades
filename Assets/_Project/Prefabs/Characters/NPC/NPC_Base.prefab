--- !u!114 &4524337077287772260
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4650398758997085827}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f31ac53a08b240840b03a0fb080b53d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogo
  nombreNPC: Recepcionista
  retratoNPC: {fileID: 538288469, guid: 0aee5be831f6eb34e8420667d355e260, type: 3}
  nombreJugador: "L\xEDa"
  retratoJugador: {fileID: 512324234644134872, guid: a72d30ce06af9d9469fdbd89ce150d42, type: 3}
  nodoInicial: inicio
  nodos:
  - id: inicio
    hablante: 0
    texto: "Bienvenidos\u2026 bienvenidos\u2026 bienvenidos\u2026"
    opciones:
    - texto: "\xBFQui\xE9n eres?"
      respuestaNPC: "La que espera\u2026 la que repite\u2026"
      siguienteNodo: pista
    - texto: "\xBFPuedes o\xEDrnos?"
      respuestaNPC: "Oigo a uno. Al otro\u2026 lo recuerdo."
      siguienteNodo: pista
    - texto: "Tranquila, no te haremos da\xF1o."
      respuestaNPC: "Eso dec\xEDan todos\u2026 eso dec\xEDan."
      siguienteNodo: pista
  - id: pista
    hablante: 0
    texto: "Tres figuras\u2026 siempre en el mismo orden."
    opciones:
    - texto: "Mu\xE9stramelas otra vez."
      respuestaNPC: "Mira sobre m\xED. Se repiten cada cinco latidos."
      siguienteNodo: historia
    - texto: "\xBFPara qu\xE9 sirven?"
      respuestaNPC: "Abren lo que \xE9l guarda bajo el mostrador."
      siguienteNodo: historia
    - texto: "\xBFLo digo yo o lo dice \xE9l?"
      respuestaNPC: "T\xFA lo ves. \xC9l lo toca."
      siguienteNodo: historia
  - id: historia
    hablante: 0
    texto: "La trece\u2026 aqu\xED no se nombra."
    opciones:
    - texto: "\xBFPor qu\xE9?"
      respuestaNPC: Porque escucha.
      siguienteNodo: pista
    - texto: "\xBFQui\xE9n escucha?"
      respuestaNPC: El que cuida. El que no duerme.
      siguienteNodo: pista
    - texto: "Entonces hablar\xE9 bajo."
      respuestaNPC: "Bajo o alto\u2026 \xE9l oye igual."
      siguienteNodo: pista
