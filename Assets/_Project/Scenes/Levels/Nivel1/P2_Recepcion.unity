  retratoNPC: {fileID: 3305382420677343518, guid: ccc2389d800ff214395fce297239da78, type: 3}
  textoInicial: "Buenas noches... Hay algo extra\xF1o ocurriendo en este hotel."
  opcion1: "\xBFQu\xE9 est\xE1 pasando?"
  respuesta1: "Desde hace unos d\xEDas aparecen s\xEDmbolos donde antes no hab\xEDa nada. No todos pueden verlos."
  opcion2: "\xBFC\xF3mo podemos avanzar?"
  respuesta2: "Miren con atenci\xF3n el panel de recepci\xF3n. Tal vez necesiten ayudarse entre ustedes."
  opcion3: 
  respuesta3: 
