    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[0].texto
      value: "Bienvenidos\u2026 bienvenidos\u2026 bienvenidos\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[1].texto
      value: "Tres figuras\u2026 siempre en el mismo orden."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[2].texto
      value: "La trece\u2026 aqu\xED no se nombra."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[11].texto
      value: "Debes observar las figuras del panel y elegir la que consideres correcta. T\xF3mate tu tiempo para revisar las indicaciones antes de decidir."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[12].texto
      value: "\xA1Con mucho gusto! Que disfrutes tu estancia. Si necesitas algo m\xE1s, aqu\xED estar\xE9 para ayudarte."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[13].texto
      value: "\xA1Con mucho gusto! Que disfrutes tu estancia. Si necesitas algo m\xE1s, aqu\xED estar\xE9 para ayudarte."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[14].texto
      value: "\xA1Con mucho gusto! Que disfrutes tu estancia. Si necesitas algo m\xE1s, aqu\xED estar\xE9 para ayudarte."
      objectReference: {fileID: 0}
