      propertyPath: nodos.Array.data[0].opciones.Array.data[0].texto
      value: "\xBFQui\xE9n eres?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[1].texto
      value: "\xBFPuedes o\xEDrnos?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[0].opciones.Array.data[2].texto
      value: "Tranquila, no te haremos da\xF1o."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[0].texto
      value: "Mu\xE9stramelas otra vez."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[1].texto
      value: "\xBFPara qu\xE9 sirven?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[1].opciones.Array.data[2].texto
      value: "\xBFLo digo yo o lo dice \xE9l?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[0].texto
      value: "\xBFPor qu\xE9?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[1].texto
      value: "\xBFQui\xE9n escucha?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[2].opciones.Array.data[2].texto
      value: "Entonces hablar\xE9 bajo."
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[11].opciones.Array.data[0].texto
      value: "\xBFHay alguna pista que pueda ayudarme?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[11].opciones.Array.data[1].texto
      value: "\xBFQu\xE9 pasa si selecciono una figura incorrecta?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[11].opciones.Array.data[2].texto
      value: Entendido, voy a intentarlo.
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[12].opciones.Array.data[0].texto
      value: "\xBFD\xF3nde puedo encontrar el panel?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[12].opciones.Array.data[1].texto
      value: "\xBFPuedo volver a preguntarte si necesito ayuda?"
      objectReference: {fileID: 0}
    - target: {fileID: 8003510675418941698, guid: a4ddb0a3b10b69b44852850d323af36a, type: 3}
      propertyPath: nodos.Array.data[12].opciones.Array.data[2].texto
      value: Gracias, voy a intentarlo.
      objectReference: {fileID: 0}
